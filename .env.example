# .env.example - Environment configuration template
# Copy this file to .env and fill in your actual values

# =============================================================================
# CORE CONFIGURATION
# =============================================================================

# Node.js environment
NODE_ENV=development

# Application logging level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# SOLANA CONFIGURATION
# =============================================================================

# Helius RPC endpoints (recommended for reliability)
HELIUS_HTTPS_URI=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
HELIUS_WSS_URI=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Alternative: Standard Solana RPC endpoints
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Solana network commitment level (processed, confirmed, finalized)
SOLANA_COMMITMENT=confirmed

# =============================================================================
# COPY TRADING CONFIGURATION
# =============================================================================

# Enable/disable copy trading (true/false)
COPY_TRADING_ENABLED=false

# Trading mode (live, paper, simulation)
TRADING_MODE=simulation

# Your Solana wallet private key (base58 encoded)
# ⚠️ KEEP THIS SECRET! Never share or commit to version control
PRIVATE_KEY=YOUR_BASE58_PRIVATE_KEY_HERE

# Your wallet's public address (for verification)
WALLET_ADDRESS=YOUR_PUBLIC_KEY_HERE

# =============================================================================
# TRADING LIMITS & RISK MANAGEMENT
# =============================================================================

# Daily trading limits
MAX_DAILY_LOSS=500              # Maximum daily loss in USD
MAX_DAILY_TRADES=20             # Maximum trades per day
MAX_DAILY_VOLUME=5000           # Maximum daily volume in USD

# Position limits
MAX_POSITION_SIZE_USD=1000      # Maximum single position size in USD
MAX_OPEN_POSITIONS=10           # Maximum open positions
MAX_TOTAL_EXPOSURE_USD=5000     # Maximum total exposure in USD

# Default copy settings
DEFAULT_COPY_PERCENTAGE=0.1     # Default copy percentage (10%)
MIN_TRADE_AMOUNT=10             # Minimum trade amount in USD
MAX_TRADE_AMOUNT=5000           # Maximum trade amount in USD

# Risk management
STOP_LOSS_PERCENTAGE=0.25       # Default stop loss (25%)
DEFAULT_SLIPPAGE=0.01           # Default slippage tolerance (1%)
MAX_PRICE_IMPACT=0.05           # Maximum acceptable price impact (5%)

# =============================================================================
# EXECUTION SETTINGS
# =============================================================================

# Transaction fees and timing
PRIORITY_FEE_SOL=0.005          # Priority fee in SOL
MAX_PRIORITY_FEE_SOL=0.02       # Maximum priority fee in SOL
EXECUTION_DELAY_MS=500          # Delay before executing trades (ms)
MAX_EXECUTION_TIME_MS=30000     # Maximum execution timeout (ms)

# Retry settings
RETRY_ATTEMPTS=3                # Number of retry attempts
RETRY_DELAY_MS=1000             # Delay between retries (ms)

# Anti-MEV protection
ANTI_MEV_ENABLED=true           # Enable anti-MEV protection

# =============================================================================
# TOKEN FILTERING
# =============================================================================

# Minimum token requirements
MIN_LIQUIDITY_USD=10000         # Minimum token liquidity required
MIN_TOKEN_HOLDERS=100           # Minimum number of token holders
MIN_VOLUME_24H_USD=1000         # Minimum 24h volume required

# Blacklisted tokens (comma-separated mint addresses)
BLACKLISTED_TOKENS=

# Whitelisted tokens (comma-separated mint addresses, optional)
WHITELISTED_TOKENS=

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database type (sqlite or postgresql)
DATABASE_TYPE=sqlite

# SQLite configuration (for development)
SQLITE_DB_PATH=src/database/copy_trading.db

# PostgreSQL configuration (for production)
# DATABASE_URL=postgresql://username:password@localhost:5432/copy_trading_bot
# DB_MAX_CONNECTIONS=20

# =============================================================================
# API & INTEGRATIONS
# =============================================================================

# GMGN API configuration
GMGN_API_BASE=https://gmgn.ai

# Application API settings (if using REST API)
PORT=3000
HOST=localhost
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# NOTIFICATIONS
# =============================================================================

# Telegram bot configuration (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email notifications (optional)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================

# Performance monitoring
ENABLE_PERFORMANCE_MONITORING=true
METRICS_RETENTION_DAYS=30

# Error tracking
ENABLE_ERROR_TRACKING=true
ERROR_RETENTION_DAYS=7

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================

# Mock/simulation settings
MOCK_LATENCY_MIN=1000           # Minimum mock latency (ms)
MOCK_LATENCY_MAX=3000           # Maximum mock latency (ms)
MOCK_SUCCESS_RATE=0.95          # Mock success rate (95%)

# Testing configuration
TEST_MODE=false                 # Enable test mode
TEST_DATABASE_URL=              # Test database URL

# Debug settings
ENABLE_VERBOSE_LOGGING=false    # Enable verbose API logging
LOG_DATABASE_QUERIES=false      # Log all database queries
LOG_API_CALLS=false             # Log all external API calls

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# API rate limiting
API_RATE_LIMIT_PER_MINUTE=60    # API requests per minute
API_RATE_LIMIT_BURST=10         # Burst allowance

# Authentication (if using REST API)
JWT_SECRET=your-jwt-secret-here
SESSION_SECRET=your-session-secret-here

# Encryption settings
ENCRYPTION_KEY=your-encryption-key-for-sensitive-data

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Memory management
MAX_LOG_ENTRIES=10000           # Maximum log entries in memory
MAX_CACHE_SIZE=1000             # Maximum cache entries

# Cleanup settings
DATA_RETENTION_DAYS=90          # How long to keep historical data
CLEANUP_INTERVAL_HOURS=24       # How often to run cleanup

# Custom timeouts
WALLET_UPDATE_TIMEOUT_MS=10000  # Timeout for wallet updates
PRICE_FETCH_TIMEOUT_MS=5000     # Timeout for price fetching
DATABASE_TIMEOUT_MS=5000        # Database operation timeout

# =============================================================================
# EXAMPLE WALLET CONFIGURATION
# =============================================================================
# Note: Wallet configuration is done in src/config/wallets.ts
# This section shows environment variables that can override defaults

# Default copy multipliers for different risk levels
LOW_RISK_COPY_MULTIPLIER=0.05   # 5% for low risk wallets
MEDIUM_RISK_COPY_MULTIPLIER=0.1 # 10% for medium risk wallets
HIGH_RISK_COPY_MULTIPLIER=0.02  # 2% for high risk wallets

# Wallet-specific overrides (example format)
# WALLET_GchNdch4w3L9SoRmHvD6G4zNYrNdQgpScLVF7DojMK4s_COPY_ENABLED=true
# WALLET_GchNdch4w3L9SoRmHvD6G4zNYrNdQgpScLVF7DojMK4s_COPY_MULTIPLIER=0.15
# WALLET_GchNdch4w3L9SoRmHvD6G4zNYrNdQgpScLVF7DojMK4s_MAX_COPY_AMOUNT=2000